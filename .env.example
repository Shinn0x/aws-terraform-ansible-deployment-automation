# Copy to .env and fill in your values. .env is git-ignored.
#   cp .env.example .env
#
# Load it into your shell before running Terraform:
#   set -a && source .env && set +a

# AWS account that owns the state bucket and the GitHub OIDC role.
# Terraform refuses to run against any other account.
#   aws sts get-caller-identity --query Account --output text
TF_VAR_aws_account_id=

# Immutable GitHub IDs used in the OIDC trust policy.
#   gh api repos/OWNER/REPO --jq '{owner_id: .owner.id, repo_id: .id}'
TF_VAR_github_owner_id=
TF_VAR_github_repo_id=
