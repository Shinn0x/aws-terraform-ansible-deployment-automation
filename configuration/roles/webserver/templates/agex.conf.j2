# Managed by Ansible
server {
    listen 80;
    listen [::]:80;
    server_name {{ webserver_server_name }};
    server_tokens off;

    # Let's Encrypt checks this path to prove you own the domain
    location /.well-known/acme-challenge/ {
        root {{ webserver_acme_root }};
    }

    # Send everything else to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}
