# Managed by Ansible
server {
    listen 80;
    listen [::]:80;
    server_name {{ webserver_server_name }};

    root {{ webserver_root }};
    index index.html;

    # Don't show the nginx version
    server_tokens off;

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
}